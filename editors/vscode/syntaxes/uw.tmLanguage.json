{
  "name": "UW",
  "scopeName": "source.uw",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#globals" },
    { "include": "#locals" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#names" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.uw",
          "match": "//.*$"
        },
        {
          "name": "comment.block.uw",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.number-sign.uw",
          "match": "(?<!\\w)#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.uw",
          "begin": "[\"“”]",
          "end": "[\"“”]",
          "patterns": [
            {
              "name": "constant.character.escape.uw",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.uw",
          "match": "\\b(?:mod|override|in|new|troop|like|on|fn|save|every|if|else|for|require|attempt|option|when|after|before|text|change|remove|do)\\b"
        }
      ]
    },
    "globals": {
      "name": "variable.other.global.uw",
      "match": "\\$[A-Za-z0-9_]+"
    },
    "locals": {
      "name": "variable.other.local.uw",
      "match": ":[A-Za-z0-9_]+"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.uw",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.uw",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "names": {
      "patterns": [
        {
          "name": "variable.other.object.uw",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:#[0-9]+)?(?:\\.[A-Za-z_][A-Za-z0-9_]*(?:#[0-9]+)?)+\\b"
        },
        {
          "name": "entity.name.function.uw",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:#[0-9]+)?(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.word.uw",
          "match": "\\b(?:and|or|not)\\b"
        },
        {
          "name": "keyword.operator.uw",
          "match": "\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|[-+*/%<>=!]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.uw",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.uw",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.uw",
          "match": "[,;]"
        }
      ]
    }
  }
}
