{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "(?:[$:][A-Za-z0-9_]+)|(?:[A-Za-z_][A-Za-z0-9_]*(?:#[0-9]+)?(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)"
}
