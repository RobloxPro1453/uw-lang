// features/stamina.uw — a resource with a bar; knows nothing about sprinting
var agent.dayaniklik = 100 in 0..100

while in mission {
    player.agent.dayaniklik += 7 per second
}

ui.bar stamina_bar {
    value      = player.agent.dayaniklik
    max        = 100
    position   = bottom_left
    size       = (600, 14)
    color      = #3FA34D
    label      = "Stamina"
}
